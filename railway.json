{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "server/**",
      "shared/**",
      "web/**",
      "Dockerfile",
      "railway.json",
      "package-lock.json"
    ]
  },
  "deploy": {
    "startCommand": "node --disable-warning=ExperimentalWarning /srv/server/src/index.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
