{
  "name": "@yesyes/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch src/index.js",
    "seed": "node --disable-warning=ExperimentalWarning src/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "keys:rotate": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/rotate-keys.mjs",
    "backup": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/backup.mjs backup",
    "restore": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/backup.mjs restore",
    "moderator": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/moderator.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "leaflet": "1.9.4"
  }
}
