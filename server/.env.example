# Zkopíruj jako .env a vyplň. V produkci (NODE_ENV=production) jsou DATA_KEY, IDENTITY_SECRET a ADMIN_TOKEN povinné.
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://api.example.cz
DB_FILE=/var/lib/yesyes/yesyes.db
TRUST_PROXY=1

# openssl rand -base64 32
DATA_KEY=
IDENTITY_SECRET=
ADMIN_TOKEN=

VERIFICATION_PROVIDER=veriff
VERIFF_API_KEY=
VERIFF_SHARED_SECRET=

SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# nebo místo TWILIO_FROM:
TWILIO_MESSAGING_SERVICE_SID=

PUSH_PROVIDER=expo
